# Copy to .env locally. Never commit a populated .env.
# Choose: none | lmstudio | openai | gemini
LLM_PROVIDER=lmstudio
ANALYSIS_PROVIDER=static_source

# Local LM Studio server: choose a model actually loaded on your machine
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b
LMSTUDIO_MAX_TOKENS=1024
LMSTUDIO_STATIC_MAX_TOKENS=4096
LMSTUDIO_TEMPERATURE=0

# Only for online providers, leave blank for local LM Studio
OPENAI_API_KEY=
# OPENAI_MODEL=your-enabled-openai-model
GEMINI_API_KEY=
# GEMINI_MODEL=your-enabled-gemini-model
